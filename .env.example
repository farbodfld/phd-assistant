# Copy to .env and fill in. Never commit .env.
# Empty values are ignored and the defaults in app/config.py are used.

ANTHROPIC_API_KEY=
MODEL_STRONG=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5
DAILY_BUDGET_USD=3.0

TIMEZONE=Europe/London
INBOX_CHECK_TIMES=["09:00","14:00","17:00","20:00"]
DAILY_RUN_TIME=09:00

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Server only (leave commented on the laptop: local runs use SQLite in data/)
# DATABASE_URL=postgresql+psycopg://phd:change-me@db:5432/phd
# POSITIONS_DIR=/data/positions
